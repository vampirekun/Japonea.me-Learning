              "type": "vocabulary",
              "prompt": "いいえ",
              "answer": "No",
              "reading": "iie",
              "explanation": "Respuesta negativa cortés. Puede acompañarse de una frase aclaratoria.",
              "examples": [
                {
                  "jp": "いいえ、がくせいじゃありません。",
                  "kana": "いいえ、がくせいじゃありません。",
                  "romaji": "Iie, gakusei ja arimasen.",
                  "es": "No, no soy estudiante."
                }
              ]
            }
          ],
          "reviewSet": [
