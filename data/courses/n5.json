        {
          "id": "n5-lesson-2",
          "title": "Presentarte y decir quién eres",
          "order": 2,
          "objectives": [
            "Decir tu nombre con una estructura sencilla.",
            "Presentar nacionalidad u ocupación con desu."
          ],
          "topics": [
            "introductions",
            "identity",
            "desu"
          ],
          "sourceRefs": [
            {
              "batchId": "batch-1",
              "category": "phrases"
            },
            {
              "batchId": "batch-1",
              "category": "countries"
            },
            {
              "batchId": "batch-1",
              "category": "occupations"
            }
          ],
          "learningItems": [
            {
              "id": "n5-grammar-wa-desu",
              "type": "grammar",
              "prompt": "わたしはアレハンドロです。",
              "answer": "Soy Alejandro.",
              "reading": "Watashi wa Alejandro desu.",
              "explanation": "Patrón inicial: tema + は + información + です. La partícula は se escribe ha, pero aquí se pronuncia wa.",
              "examples": [
                {
                  "jp": "わたしはがくせいです。",
                  "kana": "わたしはがくせいです。",
                  "romaji": "Watashi wa gakusei desu.",
                  "es": "Soy estudiante."
                }
              ]
            },
            {
              "id": "n5-grammar-intro-hajimemashite",
              "type": "vocabulary",
              "prompt": "はじめまして",
              "answer": "Mucho gusto (al conocer a alguien)",
              "reading": "hajimemashite",
              "explanation": "Se usa al presentarse por primera vez.",
              "examples": [
                {
                  "jp": "はじめまして。アレハンドロです。",
                  "kana": "はじめまして。アレハンドロです。",
                  "romaji": "Hajimemashite. Alejandro desu.",
                  "es": "Mucho gusto. Soy Alejandro."
                }
              ]
            },
            {
              "id": "n5-grammar-desu-question",
              "type": "grammar",
              "prompt": "がくせいですか。",
              "answer": "¿Eres estudiante?",
              "reading": "Gakusei desu ka.",
              "explanation": "Añadir か al final convierte una oración cortés en pregunta.",
              "examples": [
                {
                  "jp": "せんせいですか。",
                  "kana": "せんせいですか。",
                  "romaji": "Sensei desu ka.",
                  "es": "¿Es profesor/a?"
                }
              ]
            }
          ],
          "reviewSet": [
            "n5-grammar-wa-desu",
            "n5-grammar-intro-hajimemashite",
            "n5-grammar-desu-question"
          ],
          "completionPolicy": {
            "minCorrect": 0.8,
            "minAttempts": 1
          }
        }
      ]
    },
