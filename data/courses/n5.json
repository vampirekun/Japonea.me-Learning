            }
          ],
          "learningItems": [
            {
              "id": "n5-greeting-konnichiwa",
              "type": "vocabulary",
              "prompt": "こんにちは",
              "answer": "Hola / buenas tardes",
              "reading": "konnichiwa",
              "explanation": "Saludo habitual durante el día.",
              "examples": [
                {
                  "jp": "こんにちは、せんせい。",
                  "kana": "こんにちは、せんせい。",
                  "romaji": "Konnichiwa, sensei.",
                  "es": "Hola, profesor/a."
                }
              ]
            },
            {
              "id": "n5-politeness-onegaishimasu",
              "type": "vocabulary",
              "prompt": "おねがいします",
              "answer": "Por favor / se lo encargo",
              "reading": "onegaishimasu",
              "explanation": "Expresión cortés que acompaña peticiones y solicitudes.",
              "examples": [
                {
                  "jp": "もういちど おねがいします。",
                  "kana": "もういちど おねがいします。",
                  "romaji": "Mou ichido onegaishimasu.",
                  "es": "Otra vez, por favor."
                }
              ]
            },
            {
              "id": "n5-classroom-wakarimasen",
              "type": "vocabulary",
              "prompt": "わかりません",
              "answer": "No entiendo",
              "reading": "wakarimasen",
              "explanation": "Úsalo para decir que no has entendido algo.",
              "examples": []
            }
          ],
          "reviewSet": [
            "n5-greeting-konnichiwa",
