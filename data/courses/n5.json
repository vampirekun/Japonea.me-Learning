              "id": "n5-grammar-desu-question",
              "type": "grammar",
              "prompt": "がくせいですか。",
              "answer": "¿Eres estudiante?",
              "reading": "Gakusei desu ka.",
              "explanation": "Añadir か al final convierte una oración cortés en pregunta.",
              "examples": [
                {
                  "jp": "せんせいですか。",
                  "kana": "せんせいですか。",
                  "romaji": "Sensei desu ka.",
                  "es": "¿Es profesor/a?"
                }
              ]
            }
          ],
