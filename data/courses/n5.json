          "learningItems": [
            {
              "id": "n5-grammar-ja-arimasen",
              "type": "grammar",
              "prompt": "わたしはせんせいじゃありません。",
              "answer": "No soy profesor/a.",
              "reading": "Watashi wa sensei ja arimasen.",
              "explanation": "じゃありません es una forma cortés frecuente para negar una oración nominal. También existe ではありません, más formal.",
              "examples": [
                {
                  "jp": "がくせいじゃありません。",
                  "kana": "がくせいじゃありません。",
                  "romaji": "Gakusei ja arimasen.",
                  "es": "No soy estudiante."
                }
              ]
            },
            {
              "id": "n5-review-desu-contrast",
              "type": "review",
              "prompt": "せんせいです。／せんせいじゃありません。",
              "answer": "Es profesor/a. / No es profesor/a.",
              "reading": "Sensei desu. / Sensei ja arimasen.",
              "explanation": "Identifica cómo cambia el significado al pasar de afirmación a negación.",
              "examples": []
            }
          ],
          "reviewSet": [
            "n5-grammar-ja-arimasen",
            "n5-review-desu-contrast"
          ],
          "completionPolicy": {
            "minCorrect": 0.8,
            "minAttempts": 1
          }
        }
      ]
