              "id": "n5-grammar-ka",
              "type": "grammar",
              "prompt": "これはほんですか。",
              "answer": "¿Esto es un libro?",
              "reading": "Kore wa hon desu ka.",
              "explanation": "En una pregunta cortés, か suele aparecer al final de la oración.",
              "examples": [
                {
                  "jp": "これはペンですか。",
                  "kana": "これはぺんですか。",
